{
  "expo": {
    "name": "Kora",
    "slug": "TaskFlowApp",
    "scheme": "kora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kora-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kora.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#566551",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kora.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/kora-icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.446569213306-e7l66hjohlc95k087ev59lgdkd6ud68o"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8584ac2c-2da9-4ff2-939a-42c08738f97c"
      },
      "firebaseApiKey": "process.env.EXPO_PUBLIC_FIREBASE_API_KEY",
      "firebaseAuthDomain": "process.env.EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN",
      "firebaseProjectId": "process.env.EXPO_PUBLIC_FIREBASE_PROJECT_ID",
      "firebaseStorageBucket": "process.env.EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET",
      "firebaseMessagingSenderId": "process.env.EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
      "firebaseAppId": "process.env.EXPO_PUBLIC_FIREBASE_APP_ID",
      "firebaseMeasurementId": "process.env.EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID"
    }
  }
}
